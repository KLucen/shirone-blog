---
/**
 * 「数据口径与更新」折叠区（分子）：原生 `<details>/<summary>`。
 * 内容 = aboutData.provenance 逐条 + 采集时间（调用方已用站点时区格式化后传入）。
 *
 * 这一块是页面可信度的落点：口径必须逐条列出，采集时间必须来自
 * `aboutData.generatedAt` 经站点时区格式化，不做字符串切片。
 */
interface Props {
	/** 摘要行标题（i18n aboutProvenanceTitle） */
	title: string;
	/** 逐条口径说明（aboutData.provenance） */
	items: string[];
	/** 已格式化的「数据更新于 …」（i18n aboutUpdatedAt 替换 {date} 后） */
	updatedLabel: string;
	class?: string;
}

const { title, items, updatedLabel, class: className = "" } = Astro.props;
---

<details class={`m3-about-provenance ${className}`.trim()}>
	<summary class="m3-about-provenance__summary">
		<span class="m3-about-provenance__chevron" aria-hidden="true"></span>
		<span class="m3-about-provenance__summary-text">{title}</span>
	</summary>

	<div class="m3-about-provenance__body">
		<ul class="m3-about-provenance__list">
			{items.map((item) => <li class="m3-about-provenance__item">{item}</li>)}
		</ul>
		<p class="m3-about-provenance__updated">{updatedLabel}</p>
	</div>
</details>

<style lang="stylus">
.m3-about-provenance
	box-sizing: border-box
	border: 1px solid var(--outline-variant)
	border-radius: var(--shape-corner-large)
	background: var(--card-bg)
	overflow: hidden

	&__summary
		display: flex
		align-items: center
		gap: var(--m3e-space-3)
		padding: var(--m3e-space-4) var(--m3e-space-5)
		color: var(--on-surface)
		font: var(--m3e-type-title-medium)
		cursor: pointer
		list-style: none
		user-select: none
		&::-webkit-details-marker
			display: none
		&:hover
			background: var(--btn-regular-bg-hover)
		&:focus-visible
			outline: 2px solid var(--primary)
			outline-offset: -2px

	&__chevron
		flex: none
		width: 0.45rem
		height: 0.45rem
		border-right: 2px solid var(--primary)
		border-bottom: 2px solid var(--primary)
		transform: rotate(-45deg)
		transition: transform var(--m3e-duration-short) ease

	&[open] &__chevron
		transform: rotate(45deg)

	&__summary-text
		flex: 1

	&__body
		display: flex
		flex-direction: column
		gap: var(--m3e-space-4)
		padding: 0 var(--m3e-space-5) var(--m3e-space-5)

	&__list
		display: flex
		flex-direction: column
		gap: var(--m3e-space-2)
		margin: 0
		padding: var(--m3e-space-4) 0 0
		border-top: 1px solid var(--outline-variant)
		list-style: none

	&__item
		position: relative
		padding-left: var(--m3e-space-4)
		color: var(--on-surface-variant)
		font: var(--m3e-type-body-medium)
		&::before
			content: ""
			position: absolute
			top: 0.62em
			left: 0
			width: 0.3rem
			height: 0.3rem
			border-radius: var(--shape-corner-full)
			background: var(--primary)

	&__updated
		margin: 0
		color: var(--on-surface-variant)
		font: var(--m3e-type-label-medium)
		font-variant-numeric: tabular-nums
</style>
