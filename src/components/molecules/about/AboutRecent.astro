---
/**
 * 「最近写下的」区块（分子）：从博客自身文章集合里取最新几篇，渲染成小卡。
 *
 * 文章集合由页面（`pages/about.astro`）查询后作为 props 传入 ——
 * 原子/分子不直接查 collection（层间只能向下依赖，数据获取留在页面/ organism 边界之外）。
 *
 * 空集时显示 `emptyLabel`，并始终提供指向归档页的 `allLabel` 入口。
 */
interface Props {
	/** 区块标题（i18n aboutRecentTitle） */
	title: string;
	/** 每篇：已格式化的日期、标题、链接、可选分类 */
	posts: {
		title: string;
		href: string;
		date: string;
		category?: string;
	}[];
	/** 空集提示（i18n aboutRecentEmpty） */
	emptyLabel: string;
	/** 「全部文章」入口文字（i18n aboutRecentAll） */
	allLabel: string;
	/** 归档页地址 */
	allHref: string;
	class?: string;
}

const {
	title,
	posts,
	emptyLabel,
	allLabel,
	allHref,
	class: className = "",
} = Astro.props;
---

<section class={`m3-about-recent ${className}`.trim()}>
	<div class="m3-about-recent__head">
		<h2 class="m3-about-recent__title">{title}</h2>
		<a class="m3-about-recent__all" href={allHref}>
			{allLabel}
			<span class="m3-about-recent__arrow" aria-hidden="true">→</span>
		</a>
	</div>

	{
		posts.length === 0 ? (
			<p class="m3-about-recent__empty">{emptyLabel}</p>
		) : (
			<ul class="m3-about-recent__list">
				{posts.map((post) => (
					<li class="m3-about-recent__item">
						<a class="m3-about-recent__link" href={post.href}>
							<span class="m3-about-recent__item-title">{post.title}</span>
							<span class="m3-about-recent__meta">
								{post.category && (
									<span class="m3-about-recent__category">{post.category}</span>
								)}
								<time class="m3-about-recent__date">{post.date}</time>
							</span>
						</a>
					</li>
				))}
			</ul>
		)
	}
</section>

<style lang="stylus">
.m3-about-recent
	display: flex
	flex-direction: column
	gap: var(--m3e-space-4)

	&__head
		display: flex
		flex-wrap: wrap
		align-items: baseline
		justify-content: space-between
		gap: var(--m3e-space-3)

	&__title
		margin: 0
		color: var(--on-surface)
		font: var(--m3e-type-title-large)

	&__all
		display: inline-flex
		align-items: center
		gap: var(--m3e-space-1)
		color: var(--primary)
		font: var(--m3e-type-label-large)
		text-decoration: none
		&:hover
			text-decoration: underline
			text-underline-offset: 0.2em

	&__arrow
		transition: transform var(--m3e-duration-short) ease

	&__all:hover &__arrow
		transform: translateX(2px)

	&__list
		display: grid
		grid-template-columns: 1fr
		gap: var(--m3e-space-3)
		margin: 0
		padding: 0
		list-style: none
		@media (min-width: 768px)
			/* 参考稿是三张并排的文章卡 */
			grid-template-columns: repeat(3, minmax(0, 1fr))

	&__link
		display: flex
		flex-direction: column
		justify-content: space-between
		gap: var(--m3e-space-4)
		box-sizing: border-box
		height: 100%
		padding: var(--m3e-space-4)
		border: 1px solid var(--outline-variant)
		border-radius: var(--shape-corner-medium)
		background: var(--surface-container-low)
		color: var(--on-surface)
		text-decoration: none
		transition:
			background-color var(--m3e-duration-short) ease,
			border-color var(--m3e-duration-short) ease
		&:hover
			background: var(--surface-container-high)
			border-color: var(--primary)

	&__item-title
		font: var(--m3e-type-title-medium)
		/* 标题最多两行，卡片高度才齐 */
		display: -webkit-box
		-webkit-line-clamp: 2
		-webkit-box-orient: vertical
		overflow: hidden

	&__meta
		display: flex
		flex-wrap: wrap
		align-items: center
		gap: var(--m3e-space-2)

	&__category
		padding: 0 var(--m3e-space-2)
		border-radius: var(--shape-corner-full)
		background: var(--btn-regular-bg)
		color: var(--on-surface-variant)
		font: var(--m3e-type-label-small)

	&__date
		color: var(--on-surface-variant)
		font: var(--m3e-type-body-small)
		font-variant-numeric: tabular-nums

	&__empty
		margin: 0
		padding: var(--m3e-space-6)
		border: 1px dashed var(--outline-variant)
		border-radius: var(--shape-corner-medium)
		color: var(--on-surface-variant)
		font: var(--m3e-type-body-medium)
		text-align: center
</style>
