---
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import type { CollectionCard } from "@utils/card-collection";
import { url } from "@utils/url-utils";
import { Icon } from "astro-icon/components";

interface Props {
	card: CollectionCard;
}
const { card } = Astro.props;
---

<section class="card-viewer" aria-label={i18n(I18nKey.cardViewer)}>
  <header class="card-viewer__header">
    <a class="card-viewer__link m3-state-layer" data-card-back href={url("/card/")}>
      <Icon name="material-symbols:arrow-back-rounded" aria-hidden="true" />
      <span>{i18n(I18nKey.cardBack)}</span>
    </a>
    <h1 id="card-heading">{card.title} · {i18n(I18nKey.card)}</h1>
    <a class="card-viewer__link m3-state-layer" href={card.viewerUrl} target="_blank" rel="noopener" data-no-swup>
      <Icon name="material-symbols:open-in-new-rounded" aria-hidden="true" />
      <span>{i18n(I18nKey.cardOpen)}</span>
    </a>
  </header>
  <shirone-card-viewer>
    <p class="card-viewer__status" data-card-status role="status">{i18n(I18nKey.cardLoading)}</p>
    <p class="card-viewer__status" data-card-error hidden>{i18n(I18nKey.cardUnavailable)}</p>
    <iframe data-card-frame src={`${card.viewerUrl}?embed=1`} title={`${card.title} · ${i18n(I18nKey.cardViewer)}`} height="780" loading="eager"></iframe>
  </shirone-card-viewer>
</section>

<script is:inline data-astro-rerun>
  if (!customElements.get("shirone-card-viewer")) {
    customElements.define("shirone-card-viewer", class extends HTMLElement {
      connectedCallback() {
        this.frame = this.querySelector("[data-card-frame]");
        this.status = this.querySelector("[data-card-status]");
        this.error = this.querySelector("[data-card-error]");
        if (!this.frame) return;
        this.abort = new AbortController();
        const options = { signal: this.abort.signal };
        this.sendTheme = () => {
          const root = getComputedStyle(document.documentElement);
          const mapping = {
            "--paper": "--card-bg", "--ink": "--on-surface", "--muted": "--on-surface-variant",
            "--line": "--outline-variant", "--accent": "--primary", "--focus": "--primary",
            "--control": "--surface-container", "--panel": "--surface-container-low",
            "--on-primary": "--on-primary", "--radius": "--shape-corner-m",
            "--ease-out": "--m3e-easing-emphasized", "--duration": "--m3e-duration-short",
          };
          const tokens = Object.fromEntries(Object.entries(mapping).map(([key, value]) => [key, root.getPropertyValue(value).trim()]));
          tokens["--font"] = getComputedStyle(document.body).fontFamily;
          const fontFaces = [];
          for (const sheet of document.styleSheets) {
            if (sheet.href) continue;
            for (const rule of sheet.cssRules) {
              if (rule instanceof CSSFontFaceRule && tokens["--font"].includes(rule.style.fontFamily.replaceAll('"', ""))) fontFaces.push(rule.cssText);
            }
          }
          this.frame.contentWindow?.postMessage({
            type: "card:theme", theme: document.documentElement.classList.contains("dark") ? "dark" : "light",
            tokens, fontFaces: fontFaces.join("\n"),
          }, location.origin);
        };
        window.addEventListener("message", (event) => {
          if (event.origin !== location.origin || event.source !== this.frame.contentWindow) return;
          if (event.data?.type === "card:ready") {
            this.status.hidden = true;
            this.error.hidden = event.data.ready !== false;
            clearTimeout(this.timeout);
            this.sendTheme();
          } else if (event.data?.type === "card:resize" && Number.isFinite(event.data.height)) {
            this.frame.height = String(Math.max(420, Math.min(2400, Math.ceil(event.data.height))));
          }
        }, options);
        this.frame.addEventListener("load", this.sendTheme, options);
        window.addEventListener("shirone:theme-change", this.sendTheme, options);
        this.observer = new MutationObserver(this.sendTheme);
        this.observer.observe(document.documentElement, { attributes: true, attributeFilter: ["class", "style"] });
        this.timeout = setTimeout(() => { this.status.hidden = true; this.error.hidden = false; }, 30000);
        this.sendTheme();
      }
      disconnectedCallback() {
        this.abort?.abort();
        this.observer?.disconnect();
        clearTimeout(this.timeout);
      }
    });
  }
</script>

<style>
  :global(body:has(shirone-card-viewer) #live2d-widget) { display: none; }
  .card-viewer { min-width: 0; padding: 1.5rem; background: var(--card-bg); border-radius: var(--shape-corner-l); }
  .card-viewer__header { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem; padding-bottom: 1rem; border-bottom: 1px solid var(--outline-variant); }
  h1 { margin: 0; font: var(--m3e-type-title-large); color: var(--on-surface); overflow-wrap: anywhere; }
  .card-viewer__link { display: inline-flex; align-items: center; gap: 0.375rem; min-height: 2.75rem; padding: 0.5rem 0.75rem; border-radius: var(--shape-corner-s); color: var(--primary); font: var(--m3e-type-label-large); }
  .card-viewer__link :global(svg) { width: 1.125rem; height: 1.125rem; flex-shrink: 0; }
  shirone-card-viewer { display: block; min-width: 0; }
  iframe { display: block; width: 100%; border: 0; background: var(--card-bg); }
  .card-viewer__status { margin: 1rem 0; font: var(--m3e-type-body-medium); color: var(--on-surface-variant); }
  [hidden] { display: none; }
  @media (max-width: 600px) {
    .card-viewer { padding: 1rem; }
    .card-viewer__header h1 { flex-basis: 100%; order: 3; }
    :global(body:has(shirone-card-viewer) #floating-controls) { display: none; }
  }
</style>
