---
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import type { CollectionCard } from "@utils/card-collection";
import { Icon } from "astro-icon/components";
import previewModuleUrl from "@/assets/card/cabinet-preview.js?url";

interface Props {
	cards: CollectionCard[];
}
const { cards } = Astro.props;
const slotCount = Math.max(6, Math.ceil(cards.length / 3) * 3);
const emptySlots = Math.max(0, slotCount - cards.length);
---

<section class="card-section" aria-label={i18n(I18nKey.cardCabinet)}>
  <header class="card-section__header">
    <div class="card-section__heading">
      <span class="card-section__eyebrow">{i18n(I18nKey.cardCollection)}</span>
      <div class="card-section__title-row">
        <Icon name="material-symbols:style-outline-rounded" aria-hidden="true" />
        <h1 id="card-heading">{i18n(I18nKey.card)}</h1>
      </div>
      <p class="card-section__description">{i18n(I18nKey.cardDescription)}</p>
    </div>
    <div class="card-section__count" aria-label={i18n(I18nKey.cardCollected)}>
      <strong>{String(cards.length).padStart(2, "0")}</strong>
      <span>{i18n(I18nKey.cardCollected)} / {String(slotCount).padStart(2, "0")} {i18n(I18nKey.cardSlots)}</span>
    </div>
  </header>

  <shirone-card-cabinet class="cabinet" aria-label={i18n(I18nKey.cardCabinet)} data-preview-module={previewModuleUrl} data-collection={i18n(I18nKey.cardCollection)} data-kind={i18n(I18nKey.card)}>
    <canvas data-cabinet-canvas aria-hidden="true"></canvas>
    <div class="cabinet__topline" aria-hidden="true">
      <span></span>
      <span class="cabinet__mark"><Icon name="material-symbols:auto-awesome-rounded" /> {i18n(I18nKey.cardCabinet)}</span>
      <span></span>
    </div>

    <div class="cabinet__grid">
      {cards.map((card, index) => (
        <div class="display-slot display-slot--filled">
          <a
            class="collection-card m3-state-layer"
            href={card.href}
            data-rotation="0"
            aria-label={`${card.title} · ${i18n(I18nKey.cardExplore)}`}
          >
            <span class="collection-card__stage">
              <span class="collection-card__face" data-cabinet-preview data-title={card.title} data-poster={card.poster} data-layers={JSON.stringify(card.layers)}>
                {card.poster ? (
                  <img class="collection-card__poster" src={card.poster} alt="" width="512" height="768" loading={index === 0 ? "eager" : "lazy"} />
                ) : (
                  card.layers.map((layer) => <img class="collection-card__poster" src={layer} alt="" width="512" height="768" loading={index === 0 ? "eager" : "lazy"} />)
                )}
              </span>
            </span>
            <span class="collection-card__meta">
              <strong>{card.title}</strong>
              <span>{card.subtitle}</span>
            </span>
            <span class="collection-card__open" aria-hidden="true">
              <Icon name="material-symbols:arrow-forward-rounded" />
            </span>
          </a>
          <p class="display-slot__label"><span>{i18n(I18nKey.cardExplore)}</span><strong>{String(index + 1).padStart(2, "0")}</strong></p>
        </div>
      ))}

      {Array.from({ length: emptySlots }, (_, index) => (
        <div class="display-slot display-slot--empty" aria-label={i18n(I18nKey.cardEmptySlot).replace("{number}", String(cards.length + index + 1).padStart(2, "0"))}>
          <div class="empty-slot__surface">
            <Icon name="material-symbols:add-2-rounded" aria-hidden="true" />
            <span>{i18n(I18nKey.cardAwaiting)}</span>
          </div>
          <p class="display-slot__label"><span>{i18n(I18nKey.cardSlots)}</span><strong>{String(cards.length + index + 1).padStart(2, "0")}</strong></p>
        </div>
      ))}
    </div>

  </shirone-card-cabinet>
</section>

<script is:inline data-astro-rerun>
  if (!customElements.get("shirone-card-cabinet")) {
    customElements.define("shirone-card-cabinet", class extends HTMLElement {
      connectedCallback() {
        const connection = {};
        this.connection = connection;
        import(this.dataset.previewModule).then(({ mountCabinet }) => {
          if (this.isConnected && this.connection === connection) this.cleanup = mountCabinet(this);
        }).catch(() => { this.dataset.previewState = "fallback"; });
      }
      disconnectedCallback() {
        this.connection = null;
        this.cleanup?.();
        this.cleanup = null;
      }
    });
  }
</script>

<style>
  :global(body:has(.card-section) #live2d-widget) { display: none; }

  .card-section {
    min-width: 0;
    overflow: hidden;
    padding: clamp(1.25rem, 3vw, 2rem);
    color: var(--on-surface);
    background: var(--card-bg);
    border-radius: var(--shape-corner-l);
  }

  .card-section__header { display: flex; align-items: flex-end; justify-content: space-between; gap: 1.5rem; padding: 0.25rem 0 1.5rem; border-bottom: 1px solid var(--outline-variant); }
  .card-section__heading { min-width: 0; }
  .card-section__eyebrow { display: block; margin-bottom: 0.65rem; color: var(--primary); font: var(--m3e-type-label-medium); }
  .card-section__title-row { display: flex; align-items: center; gap: 0.75rem; }
  .card-section__title-row :global(svg) { width: 1.75rem; height: 1.75rem; color: var(--primary); flex-shrink: 0; }
  h1 { margin: 0; font: var(--m3e-type-headline-small); overflow-wrap: anywhere; }
  .card-section__description { margin: 0.45rem 0 0; max-width: 34rem; color: var(--on-surface-variant); font: var(--m3e-type-body-medium); }
  .card-section__count { display: flex; align-items: baseline; gap: 0.5rem; color: var(--on-surface-variant); font: var(--m3e-type-label-small); }
  .card-section__count strong { color: var(--on-surface); font: var(--m3e-type-headline-small); font-variant-numeric: tabular-nums; }

  .cabinet { display: block; position: relative; margin-top: 1.5rem; padding: 0 0.75rem 0.75rem; overflow: hidden; background: var(--surface-container-low); border: 6px solid var(--outline-variant); border-radius: var(--shape-corner-s); }
  .cabinet__topline { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1rem; padding: 1rem 0.75rem; color: var(--on-surface-variant); font: var(--m3e-type-label-small); }
  .cabinet__topline > span:first-child, .cabinet__topline > span:last-child { height: 1px; background: var(--outline-variant); }
  .cabinet__mark { display: inline-flex; align-items: center; gap: 0.4rem; white-space: nowrap; }
  .cabinet__mark :global(svg) { width: 1rem; height: 1rem; color: var(--primary); }
  .cabinet__grid { position: relative; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }

  .display-slot { position: relative; min-width: 0; padding: 1.25rem 0.75rem 1.5rem; border-bottom: 7px solid var(--outline-variant); box-shadow: inset 0 -1px var(--surface-bright), 0 6px 8px -6px var(--outline); }
  .display-slot:nth-child(3n + 2), .display-slot:nth-child(3n + 3) { border-left: 1px solid color-mix(in oklab, var(--outline-variant) 50%, transparent); }
  .display-slot--filled { display: flex; flex-direction: column; align-items: center; }
  .collection-card { position: relative; display: block; width: min(100%, 11rem); padding: 0; color: inherit; text-decoration: none; border-radius: var(--shape-corner-s); touch-action: manipulation; -webkit-tap-highlight-color: transparent; }
  .collection-card__stage { display: grid; place-items: center; width: 100%; aspect-ratio: 2 / 3; }
  .collection-card__face { display: block; position: relative; width: 100%; height: 100%; }
  .collection-card__poster { position: absolute; inset: 5%; width: 90%; height: 90%; object-fit: contain; border-radius: var(--shape-corner-xs); }
  .cabinet :global([data-cabinet-canvas]) { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 1; }
  .cabinet[data-preview-state="ready"] .collection-card[data-preview-state="ready"] .collection-card__poster { opacity: 0; }
  .collection-card__meta { display: flex; flex-direction: column; align-items: center; gap: 0.2rem; padding-top: 0.75rem; }
  .collection-card__meta strong { font: var(--m3e-type-title-medium); overflow-wrap: anywhere; text-align: center; }
  .collection-card__meta span { color: var(--on-surface-variant); font: var(--m3e-type-label-small); overflow-wrap: anywhere; text-align: center; }
  .collection-card__open { position: absolute; top: 0.5rem; right: 0; display: grid; place-items: center; width: 2rem; height: 2rem; color: var(--on-primary); background: var(--primary); border-radius: var(--shape-corner-full); opacity: 0; transition: opacity var(--m3e-duration-short) var(--m3e-easing-standard); z-index: 2; }
  .collection-card__open :global(svg) { width: 1.1rem; height: 1.1rem; }
  .collection-card:focus-visible .collection-card__open { opacity: 1; }
  .collection-card:focus-visible { outline: 2px solid var(--primary); outline-offset: 5px; }
  .display-slot__label { display: flex; align-items: baseline; justify-content: space-between; gap: 0.5rem; width: min(100%, 11rem); margin: 0.75rem 0 0; color: var(--on-surface-variant); font: var(--m3e-type-label-small); }
  .display-slot__label span { overflow-wrap: anywhere; }
  .display-slot__label strong { color: var(--primary); font-weight: 500; }

  .display-slot--empty { display: flex; flex-direction: column; align-items: center; }
  .empty-slot__surface { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.7rem; width: min(100%, 11rem); aspect-ratio: 2 / 3; color: var(--on-surface-variant); }
  .empty-slot__surface::before { content: ""; position: absolute; inset: 5%; border: 1px dashed var(--outline-variant); border-radius: var(--shape-corner-xs); pointer-events: none; }
  .empty-slot__surface :global(svg) { width: 1.5rem; height: 1.5rem; color: var(--tertiary); }
  .empty-slot__surface span { font: var(--m3e-type-label-small); text-align: center; overflow-wrap: anywhere; }
  .display-slot--empty .display-slot__label { margin-top: auto; padding-top: 0.75rem; }

  @media (hover: hover) and (pointer: fine) {
    .collection-card:hover .collection-card__open { opacity: 1; }
  }
  @media (max-width: 700px) {
    .card-section__header { align-items: flex-start; flex-direction: column; gap: 0.75rem; }
    .card-section__count { align-self: flex-start; }
    .cabinet__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .display-slot:nth-child(n) { border-left: 0; }
    .display-slot:nth-child(even) { border-left: 1px solid color-mix(in oklab, var(--outline-variant) 50%, transparent); }
  }
  @media (max-width: 420px) {
    .card-section { padding: 1rem; }
    .cabinet { margin-top: 1rem; padding: 0 0.35rem 0.35rem; border-width: 4px; }
    .display-slot { padding-right: 0.5rem; padding-left: 0.5rem; }
    :global(body:has(.card-section) #floating-controls) { display: none; }
  }
</style>
