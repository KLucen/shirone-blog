---
import CardSection from "@components/organisms/CardSection.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { loadCardCollection } from "@utils/card-collection";

const pageTitle = i18n(I18nKey.card);
const pageDescription = i18n(I18nKey.cardDescription);
const cards = loadCardCollection();
---

<MainGridLayout title={pageTitle} description={pageDescription} page="card">
	<CardSection cards={cards} />
</MainGridLayout>
